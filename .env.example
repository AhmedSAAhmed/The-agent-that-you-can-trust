# Copy to .env (git-ignored) for local runs. On Hugging Face, add these as Space secrets/variables instead.
# Paste the key as plain text: no quotes needed.
OPENROUTER_API_KEY=
# Comma-separated list, tried in order. Free models are often rate-limited upstream;
# anthropic/claude-haiku-5.5 costs about $0.0001 per message and is far more reliable.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5,google/gemma-4-31b-it:free
