# Copy to .env (git-ignored) for local runs. On Hugging Face, add these as Space secrets instead.
# Paste keys as plain text, no quotes. Any key you leave empty is skipped. All three have free tiers, no card needed.
GROQ_API_KEY=        # https://console.groq.com/keys      (~1,000 requests/day per model, very fast)
GEMINI_API_KEY=      # https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=  # https://openrouter.ai/keys         (50 free requests/day)
# Optional model overrides (comma-separated, tried in order); defaults live in src/trustdesk/reader.py
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-lite-latest
# OPENROUTER_MODEL=recursive/flint-v1.0:free,liquid/lfm-3-1.7b:free
